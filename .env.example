# Copy these into Render -> Environment (do NOT commit a real .env).

# Supabase: Connect -> "Session pooler" connection string (works from Render; the direct db.* host does not).
DATABASE_URL=postgresql://postgres.YOURPROJECTREF:YOURPASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Signs login cookies. Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
TAVILY_API_KEY=
OFFLINE_FIRST=0

# ---- E-mail codes for sign up / forgot password / code login (FREE: Brevo, 300 e-mails a day, no card) ----
# 1) Make a free account at brevo.com  2) Senders > add and verify your own e-mail address (no domain needed)
# 3) SMTP & API > API keys > create a key  4) put the two lines below here AND in Render > Environment
BREVO_API_KEY=
MAIL_FROM=you@gmail.com
MAIL_FROM_NAME=AI Vidyalaya
# Only for testing on your own PC (does not work on Render free): SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=  SMTP_PASSWORD=<gmail app password>
